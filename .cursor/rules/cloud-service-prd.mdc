#### 3.2 Add Event Handlers
**Location**: `src/renderer/screens/settings-screen.js`

Add event handlers in the `setupEventListeners` method:

```javascript
// [Service Name] settings
const [serviceName]EnableToggle = document.getElementById('[serviceName]EnableToggle');
const [serviceName]Settings = document.getElementById('[serviceName]Settings');
const test[ServiceName]Btn = document.getElementById('test[ServiceName]Btn');

if ([serviceName]EnableToggle) {
    [serviceName]EnableToggle.addEventListener('change', () => {
        if ([serviceName]EnableToggle.checked) {
            [serviceName]Settings?.classList.remove('hidden');
            test[ServiceName]Btn?.removeAttribute('disabled');
        } else {
            [serviceName]Settings?.classList.add('hidden');
            test[ServiceName]Btn?.setAttribute('disabled', 'true');
        }
        this.save[ServiceName]Settings();
    });
}

// Add event listeners for all configuration fields
['[serviceName]Endpoint', '[serviceName]Bucket', '[serviceName]AccessKey', '[serviceName]SecretKey'].forEach(fieldId => {
    const field = document.getElementById(fieldId);
    if (field) {
        field.addEventListener('input', () => this.save[ServiceName]Settings());
        field.addEventListener('blur', () => this.save[ServiceName]Settings());
    }
});

// Test connection button
if (test[ServiceName]Btn) {
    test[ServiceName]Btn.addEventListener('click', () => this.test[ServiceName]Connection());
}
