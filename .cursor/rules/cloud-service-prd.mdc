    if ([serviceName]Endpoint) [serviceName]Endpoint.value = [serviceName]Service.endpoint || '';
    if ([serviceName]Bucket) [serviceName]Bucket.value = [serviceName]Service.bucket || '';
    if ([serviceName]AccessKey) [serviceName]AccessKey.value = [serviceName]Service.accessKey || '';
    if ([serviceName]SecretKey) [serviceName]SecretKey.value = [serviceName]Service.secretKey || '';
}
```

