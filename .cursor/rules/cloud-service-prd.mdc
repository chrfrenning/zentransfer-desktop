#### 3.3 Add Settings Management Methods
**Location**: `src/renderer/screens/settings-screen.js`

```javascript
async save[ServiceName]Settings() {
    try {
        const [serviceName]Enabled = document.getElementById('[serviceName]EnableToggle')?.checked || false;
        const [serviceName]Endpoint = document.getElementById('[serviceName]Endpoint')?.value || '';
        const [serviceName]Bucket = document.getElementById('[serviceName]Bucket')?.value || '';
        const [serviceName]AccessKey = document.getElementById('[serviceName]AccessKey')?.value || '';
        const [serviceName]SecretKey = document.getElementById('[serviceName]SecretKey')?.value || '';

        await window.electronAPI.config.updateCloudService('[service-type]', {
            enabled: [serviceName]Enabled,
            endpoint: [serviceName]Endpoint,
            bucket: [serviceName]Bucket,
            accessKey: [serviceName]AccessKey,
            secretKey: [serviceName]SecretKey
        });

        console.log('[Service Name] settings saved');
    } catch (error) {
        console.error('Failed to save [Service Name] settings:', error);
    }
}

async test[ServiceName]Connection() {
    const testBtn = document.getElementById('test[ServiceName]Btn');
    const testIcon = document.getElementById('test[ServiceName]Icon');
    
    if (!testBtn || testBtn.disabled) return;

    try {
        // Show loading state
        testBtn.disabled = true;
        testIcon.className = 'w-5 h-5 animate-spin text-gray-400';

        const settings = {
            endpoint: document.getElementById('[serviceName]Endpoint')?.value || '',
            bucket: document.getElementById('[serviceName]Bucket')?.value || '',
            accessKey: document.getElementById('[serviceName]AccessKey')?.value || '',
            secretKey: document.getElementById('[serviceName]SecretKey')?.value || ''
        };

        const result = await window.electronAPI.uploadService.test('[service-type]', settings);

        if (result.success && result.result.success) {
            // Success state
            testIcon.className = 'w-5 h-5 text-green-500';
            this.showNotification('[Service Name] connection test successful!', 'success');
        } else {
            // Error state
            testIcon.className = 'w-5 h-5 text-red-500';
            this.showNotification(`[Service Name] connection test failed: ${result.result?.message || 'Unknown error'}`, 'error');
        }
    } catch (error) {
        // Error state
        testIcon.className = 'w-5 h-5 text-red-500';
        this.showNotification(`[Service Name] connection test failed: ${error.message}`, 'error');
    } finally {
        // Re-enable button after delay
        setTimeout(() => {
            testBtn.disabled = false;
            testIcon.className = 'w-5 h-5 transition-all duration-300';
        }, 2000);
    }
}
```

