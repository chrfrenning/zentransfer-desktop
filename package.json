{
  "name": "ZenTransfer",
  "version": "0.1.22",
  "description": "File transfer for professional photographers",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "main": "electron . --dev",
    "dev": "concurrently \"npm run dev-react\" \"wait-on http://127.0.0.1:4000 && electron . --dev\"",
    "dev-react": "vite --config vite.config.js",
    "build-react": "vite build --config vite.config.js",
    "build-react-dev": "vite build --config vite.config.js --mode development",
    "preview-react": "vite preview --config vite.config.js",
    "build": "npm run build-react && electron-builder",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "publish": "npm run build-react && electron-builder --publish=always",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "electron",
    "zentransfer",
    "photography",
    "ftp",
    "cloud",
    "file transfer"
  ],
  "author": "Perceptron AS",
  "license": "AGPL-3.0",
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^27.0.0",
    "electron-builder": "^24.13.3",
    "electron-reload": "^2.0.0-alpha.1",
    "glob": "^11.0.2",
    "tailwindcss": "^3.3.5",
    "vite": "^5.0.0",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.perceptron.zentransfer",
    "productName": "ZenTransfer",
    "publish": {
      "provider": "github",
      "owner": "chrfrenning",
      "repo": "zentransfer-desktop"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "./entitlements.mac.plist",
      "entitlementsInherit": "./entitlements.mac.plist",
      "icon": "./icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "./icon.ico",
      "sign": "./azure-sign.js",
      "signingHashAlgorithms": [
        "sha256"
      ]
    },
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "config.js",
      "src/**/*",
      "main/**/*",
      "ui/**/*",
      "package.json",
      "node_modules/**/*",
      "dist-react/**/*"
    ],
    "extraResources": [
      {
        "from": "node_modules/@aws-sdk",
        "to": "node_modules/@aws-sdk",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/@azure",
        "to": "node_modules/@azure",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/@google-cloud",
        "to": "node_modules/@google-cloud",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.817.0",
    "@aws-sdk/s3-request-presigner": "^3.844.0",
    "@azure/storage-blob": "^12.27.0",
    "@google-cloud/storage": "^7.16.0",
    "@headlessui/react": "^2.2.4",
    "@heroicons/react": "^2.2.0",
    "better-sqlite3": "^12.2.0",
    "electron-log": "^5.4.1",
    "electron-updater": "^6.6.2",
    "exiftool-vendored": "^30.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sharp": "^0.34.3",
    "zustand": "^5.0.6"
  }
}
